---
// Componente de mapa interactivo del estadio
---

<div class="bg-dark-light rounded-xl p-6">
  <h3 class="text-xl font-bold text-white mb-4">Selecciona tu ubicación</h3>
  
  <!-- Leyenda -->
  <div class="flex gap-4 mb-6 text-sm">
    <div class="flex items-center gap-2">
      <div class="w-4 h-4 bg-green-500 rounded"></div>
      <span class="text-gray-400">Disponible</span>
    </div>
    <div class="flex items-center gap-2">
      <div class="w-4 h-4 bg-red-500 rounded"></div>
      <span class="text-gray-400">Ocupado</span>
    </div>
    <div class="flex items-center gap-2">
      <div class="w-4 h-4 bg-primary rounded"></div>
      <span class="text-gray-400">Seleccionado</span>
    </div>
  </div>
  
  <!-- Campo de fútbol -->
  <div class="relative bg-gradient-to-b from-green-900 to-green-800 rounded-lg p-8 mb-6">
    <div class="absolute inset-0 flex items-center justify-center">
      <div class="border-2 border-white/30 rounded-lg w-3/4 h-3/4 flex items-center justify-center">
        <div class="border-2 border-white/30 rounded-full w-32 h-32"></div>
      </div>
    </div>
    <div class="relative z-10 text-center">
      <p class="text-white/50 text-xs font-bold mb-2">CANCHA</p>
      <p class="text-white/50 text-xs">⚽</p>
    </div>
  </div>
  
  <!-- Localidades clickeables -->
  <div id="localidades-container" class="space-y-3">
    <div class="text-center py-8">
      <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
      <p class="text-gray-400 mt-2 text-sm">Cargando localidades...</p>
    </div>
  </div>
</div>

<script>
  import { fetchAPI } from '../lib/api';
  
  let partidoId: string | null = null;
  let localidadesData: any[] = [];
  let ocupacionData: any = {};
  
  // Obtener ID del partido desde la URL
  partidoId = window.location.pathname.split('/').pop();
  
  async function cargarLocalidades() {
    try {
      const container = document.getElementById('localidades-container');
      if (!container) return;
      
      // Obtener partido para conocer el estadio
      console.log('Cargando partido:', partidoId);
      const partido = await fetchAPI(`/partidos/${partidoId}`);
      console.log('Partido cargado:', partido);
      console.log('Estadio ID:', partido.estadio._id);
      
      // Obtener localidades desde la base de datos
      console.log('Solicitando localidades...');
      const localidadesResp = await fetchAPI(`/localidades?estadio=${partido.estadio._id}`);
      console.log('Localidades recibidas:', localidadesResp);
      
      // Mapear colores según el nombre de la localidad
      const coloresLocalidades: Record<string, string> = {
        'Norte': 'bg-green-600',
        'Sur': 'bg-yellow-500',
        'Oriental': 'bg-sky-600',
        'Occidental': 'bg-orange-600'
      };
      
      const localidades = localidadesResp.map((loc: any) => ({
        ...loc,
        color: coloresLocalidades[loc.nombre] || 'bg-gray-600',
        capacidad: loc.filas * loc.columnas,
        asientosPorFila: loc.columnas
      }));
      
      localidadesData = localidades;
      
      container.innerHTML = localidades.map((loc: any) => `
        <button 
          class="localidad-btn w-full ${loc.color} hover:opacity-80 text-white rounded-lg p-6 transition flex items-center justify-between group shadow-lg"
          data-id="${loc._id}"
          data-nombre="${loc.nombre}"
          data-precio="${loc.precio_base}"
          data-filas="${loc.filas}"
          data-asientos="${loc.asientosPorFila}"
        >
          <div class="text-left">
            <p class="font-bold text-2xl mb-1">${loc.nombre}</p>
            <p class="text-sm opacity-90">📍 Capacidad: ${loc.capacidad.toLocaleString()} personas</p>
            <p class="text-xs opacity-75 mt-1">${loc.filas} filas • ${loc.asientosPorFila} asientos por fila</p>
          </div>
          <div class="text-right">
            <p class="text-3xl font-bold mb-1">$${loc.precio_base.toLocaleString()}</p>
            <p class="text-xs opacity-75 group-hover:translate-x-1 transition-transform">Ver asientos →</p>
          </div>
        </button>
      `).join('');
      
      // Event listeners
      document.querySelectorAll('.localidad-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const id = target.getAttribute('data-id') || '';
          const nombre = target.getAttribute('data-nombre') || '';
          const precio = parseInt(target.getAttribute('data-precio') || '0');
          const filas = parseInt(target.getAttribute('data-filas') || '10');
          const asientosPorFila = parseInt(target.getAttribute('data-asientos') || '20');
          
          // Dispatch evento para mostrar asientos
          window.dispatchEvent(new CustomEvent('localidad-selected', {
            detail: { 
              id,
              zona: nombre, 
              precio,
              filas,
              asientosPorFila
            }
          }));
        });
      });
      
    } catch (error) {
      console.error('Error cargando localidades:', error);
      const container = document.getElementById('localidades-container');
      if (container) {
        container.innerHTML = `
          <div class="col-span-full text-center py-8">
            <p class="text-red-500">Error cargando localidades</p>
            <p class="text-gray-400 text-sm mt-2">${error instanceof Error ? error.message : 'Error desconocido'}</p>
          </div>
        `;
      }
    }
  }
  
  cargarLocalidades();
</script>
