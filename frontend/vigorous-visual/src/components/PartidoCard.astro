---
interface Props {
  partido: {
    _id: string;
    equipo_local: string;
    equipo_visitante: string;
    fecha: string;
    hora: string;
    estadio: {
      nombre: string;
      ciudad: string;
    };
    precio_base: number;
    imagen?: string;
  };
}

const { partido } = Astro.props;
const fechaFormateada = new Date(partido.fecha).toLocaleDateString('es-ES', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<div class="bg-dark-light rounded-xl overflow-hidden hover:scale-105 transition-transform duration-300 shadow-lg">
  <div class="relative h-48">
    <img 
      src={partido.imagen || 'https://images.unsplash.com/photo-1574629810360-7efbbe195018?w=800'} 
      alt={`${partido.equipo_local} vs ${partido.equipo_visitante}`}
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
    <div class="absolute bottom-4 left-4 right-4">
      <h3 class="text-2xl font-bold text-white">
        {partido.equipo_local} <span class="text-primary">vs</span> {partido.equipo_visitante}
      </h3>
    </div>
  </div>
  
  <div class="p-6">
    <div class="space-y-3 mb-6">
      <div class="flex items-center text-gray-300">
        <svg class="w-5 h-5 mr-2 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>{fechaFormateada}</span>
      </div>
      
      <div class="flex items-center text-gray-300">
        <svg class="w-5 h-5 mr-2 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{partido.hora}</span>
      </div>
      
      <div class="flex items-center text-gray-300">
        <svg class="w-5 h-5 mr-2 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>{partido.estadio.nombre}, {partido.estadio.ciudad}</span>
      </div>
    </div>
    
    <div class="flex items-center justify-between">
      <div>
        <p class="text-gray-400 text-sm">Desde</p>
        <p class="text-2xl font-bold text-primary">${partido.precio_base.toLocaleString()}</p>
      </div>
      
      <a 
        href={`/comprar/${partido._id}`}
        class="bg-primary hover:bg-sky-600 text-white px-6 py-2 rounded-lg font-semibold transition"
      >
        Comprar
      </a>
    </div>
  </div>
</div>
