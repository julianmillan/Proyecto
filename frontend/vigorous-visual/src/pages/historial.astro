---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="Historial - EstadioApp">
  <div class="min-h-screen bg-dark">
    <Navbar />
    
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="mb-8">
        <h1 class="text-4xl font-bold text-white mb-2">Mi Historial</h1>
        <p class="text-gray-400">Tus boletas y reservas</p>
      </div>
      
      <!-- Tabs -->
      <div class="flex gap-4 mb-8 border-b border-gray-800">
        <button 
          class="tab-btn px-6 py-3 font-semibold border-b-2 border-primary text-primary"
          data-tab="activas"
        >
          Boletas Activas
        </button>
        <button 
          class="tab-btn px-6 py-3 font-semibold border-b-2 border-transparent text-gray-400 hover:text-white"
          data-tab="historial"
        >
          Historial Completo
        </button>
      </div>
      
      <!-- Content -->
      <div id="boletas-container" class="space-y-4">
        <div class="text-center py-12">
          <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-primary"></div>
          <p class="text-gray-400 mt-4">Cargando historial...</p>
        </div>
      </div>
    </main>
  </div>
</Layout>

<script>
  import { fetchAPI, isAuthenticated } from '../lib/api';
  
  if (!isAuthenticated()) {
    window.location.href = '/login';
  }
  
  let currentTab = 'activas';
  
  async function loadHistorial() {
    try {
      const historial = await fetchAPI('/historial');
      const container = document.getElementById('boletas-container');
      
      if (!container) return;
      
      const filtered = currentTab === 'activas' 
        ? historial.filter((b: any) => b.estado === 'ACTIVA')
        : historial;
      
      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="text-center py-12">
            <p class="text-gray-400">No hay boletas en esta sección</p>
          </div>
        `;
        return;
      }
      
      container.innerHTML = filtered.map((boleta: any) => {
        const estadoColors: Record<string, string> = {
          'activa': 'bg-green-600',
          'usada': 'bg-gray-600',
          'cancelada': 'bg-red-600'
        };
        const estadoColor = estadoColors[boleta.estado] || 'bg-gray-600';
        
        return `
          <div class="bg-dark-light rounded-xl p-6 border-l-4 border-primary">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="text-xl font-bold text-white">
                  ${boleta.partido?.equipo_local || 'TBD'} vs ${boleta.partido?.equipo_visitante || 'TBD'}
                </h3>
                <p class="text-gray-400 text-sm">
                  ${new Date(boleta.partido?.fecha || Date.now()).toLocaleDateString('es-ES')} - ${boleta.partido?.hora || ''}
                </p>
              </div>
              <span class="${estadoColor} text-white text-xs px-3 py-1 rounded-full">
                ${boleta.estado.toUpperCase()}
              </span>
            </div>
            
            <div class="grid grid-cols-2 gap-4 mb-4">
              <div>
                <p class="text-gray-400 text-sm">Localidad</p>
                <p class="text-white font-semibold">${boleta.silla?.localidad?.nombre || 'N/A'}</p>
              </div>
              <div>
                <p class="text-gray-400 text-sm">Asiento</p>
                <p class="text-white font-semibold">Fila ${boleta.silla?.fila || ''} - Asiento ${boleta.silla?.columna || ''}</p>
              </div>
              <div>
                <p class="text-gray-400 text-sm">Precio</p>
                <p class="text-primary font-bold text-lg">$${(boleta.precio_total || 0).toLocaleString()}</p>
              </div>
              <div>
                <p class="text-gray-400 text-sm">Fecha de compra</p>
                <p class="text-white">${new Date(boleta.fecha_compra || Date.now()).toLocaleDateString('es-ES')}</p>
              </div>
            </div>
            
            ${boleta.estado === 'ACTIVA' ? `
              <div class="mt-4 space-y-3">
                <div class="bg-white p-4 rounded-lg">
                  <p class="text-gray-600 text-xs text-center mb-2">Código QR</p>
                  <div class="flex justify-center">
                    <img 
                      src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(boleta.codigo_qr)}"
                      alt="Código QR"
                      class="w-[200px] h-[200px]"
                    />
                  </div>
                  <p class="text-gray-500 text-xs text-center mt-2">${boleta.codigo_qr}</p>
                </div>
                <button 
                  class="w-full bg-red-600 hover:bg-red-700 text-white py-2 rounded-lg transition btn-cancelar"
                  data-boleta-id="${boleta._id}"
                >
                  Cancelar Boleta
                </button>
              </div>
            ` : ''}
          </div>
        `;
      }).join('');
      
      // Add cancel event listeners
      document.querySelectorAll('.btn-cancelar').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const boletaId = (e.target as HTMLElement).getAttribute('data-boleta-id');
          if (confirm('¿Estás seguro de cancelar esta boleta?')) {
            try {
              await fetchAPI(`/cancelar/${boletaId}`, { method: 'PATCH' });
              alert('Boleta cancelada');
              loadHistorial();
            } catch (error: any) {
              alert(error.message || 'Error al cancelar');
            }
          }
        });
      });
      
    } catch (error) {
      console.error('Error loading historial:', error);
      const container = document.getElementById('boletas-container');
      if (container) {
        container.innerHTML = `
          <div class="text-center py-12">
            <p class="text-red-500">Error al cargar el historial</p>
          </div>
        `;
      }
    }
  }
  
  // Tab switching
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      currentTab = target.getAttribute('data-tab') || 'activas';
      
      // Update UI
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('border-primary', 'text-primary');
        b.classList.add('border-transparent', 'text-gray-400');
      });
      
      target.classList.remove('border-transparent', 'text-gray-400');
      target.classList.add('border-primary', 'text-primary');
      
      loadHistorial();
    });
  });
  
  loadHistorial();
</script>
