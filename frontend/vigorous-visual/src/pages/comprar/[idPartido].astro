---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import StadiumMap from '../../components/StadiumMap.astro';
import SillaSelector from '../../components/SillaSelector.astro';
import PaymentMethodSelector from '../../components/PaymentMethodSelector.astro';
---

<Layout title="Comprar Boleta - EstadioApp">
  <div class="min-h-screen bg-dark">
    <Navbar />
    
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Partido Info -->
      <div id="partido-info" class="bg-dark-light rounded-xl p-6 mb-8">
        <div class="animate-pulse">
          <div class="h-8 bg-gray-700 rounded w-1/2 mb-4"></div>
          <div class="h-4 bg-gray-700 rounded w-1/3"></div>
        </div>
      </div>
      
      <!-- Main Content -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Selection Panel -->
        <div class="lg:col-span-2 space-y-6">
          <StadiumMap />
          <SillaSelector />
          <PaymentMethodSelector />
        </div>
        
        <!-- Summary Panel -->
        <div class="lg:col-span-1">
          <div class="bg-dark-light rounded-xl p-6 sticky top-8">
            <h3 class="text-xl font-bold text-white mb-6">Resumen de compra</h3>
            
            <div class="space-y-4 mb-6">
              <div class="flex justify-between text-gray-400">
                <span>Zona:</span>
                <span id="summary-zona" class="text-white">-</span>
              </div>
              <div class="flex justify-between text-gray-400">
                <span>Asiento:</span>
                <span id="summary-silla" class="text-white">-</span>
              </div>
              <div class="flex justify-between text-gray-400">
                <span>Método de pago:</span>
                <span id="summary-payment" class="text-white">-</span>
              </div>
              
              <div class="border-t border-gray-700 pt-4">
                <div class="flex justify-between text-xl font-bold">
                  <span class="text-white">Total:</span>
                  <span id="summary-total" class="text-primary">$0</span>
                </div>
              </div>
            </div>
            
            <button 
              id="btn-reservar"
              disabled
              class="w-full bg-yellow-600 hover:bg-yellow-700 disabled:bg-gray-700 disabled:cursor-not-allowed text-white font-semibold py-3 rounded-lg transition mb-3"
            >
              Reservar (15 min)
            </button>
            
            <button 
              id="btn-comprar"
              disabled
              class="w-full bg-primary hover:bg-sky-600 disabled:bg-gray-700 disabled:cursor-not-allowed text-white font-semibold py-3 rounded-lg transition"
            >
              Comprar Ahora
            </button>
            
            <p class="text-xs text-gray-500 text-center mt-4">
              La reserva se mantendrá activa por 15 minutos
            </p>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>

<script>
  import { fetchAPI, isAuthenticated } from '../../lib/api';
  
  if (!isAuthenticated()) {
    window.location.href = '/login';
  }
  
  // Get partido ID from URL
  const partidoId = window.location.pathname.split('/').pop();
  
  let selectedData = {
    zona: '',
    precio: 0,
    fila: '',
    numero: '',
    payment: ''
  };
  
  // Load partido info
  async function loadPartido() {
    try {
      const partido = await fetchAPI(`/partidos/${partidoId}`);
      const infoDiv = document.getElementById('partido-info');
      
      if (infoDiv) {
        infoDiv.innerHTML = `
          <h2 class="text-3xl font-bold text-white mb-2">
            ${partido.equipo_local} <span class="text-primary">vs</span> ${partido.equipo_visitante}
          </h2>
          <div class="flex gap-6 text-gray-400">
            <span>📅 ${new Date(partido.fecha).toLocaleDateString('es-ES')}</span>
            <span>🕒 ${partido.hora}</span>
            <span>📍 ${partido.estadio?.nombre || 'Estadio'}</span>
          </div>
        `;
      }
    } catch (error) {
      console.error('Error loading partido:', error);
    }
  }
  
  // Update summary
  function updateSummary() {
    const summaryZona = document.getElementById('summary-zona');
    const summarySilla = document.getElementById('summary-silla');
    const summaryPayment = document.getElementById('summary-payment');
    const summaryTotal = document.getElementById('summary-total');
    const btnReservar = document.getElementById('btn-reservar') as HTMLButtonElement;
    const btnComprar = document.getElementById('btn-comprar') as HTMLButtonElement;
    
    if (summaryZona) summaryZona.textContent = selectedData.zona || '-';
    if (summarySilla && selectedData.fila && selectedData.numero) {
      summarySilla.textContent = `${selectedData.fila}${selectedData.numero}`;
    }
    if (summaryPayment) summaryPayment.textContent = selectedData.payment || '-';
    if (summaryTotal) summaryTotal.textContent = `$${selectedData.precio.toLocaleString()}`;
    
    // Enable buttons if all data is selected
    const canProceed = selectedData.zona && selectedData.fila && selectedData.numero && selectedData.payment;
    if (btnReservar) btnReservar.disabled = !canProceed;
    if (btnComprar) btnComprar.disabled = !canProceed;
  }
  
  // Listen to custom events
  window.addEventListener('zona-selected', ((e: CustomEvent) => {
    selectedData.zona = e.detail.zona;
    selectedData.precio = e.detail.precio;
    updateSummary();
  }) as EventListener);
  
  window.addEventListener('silla-selected', ((e: CustomEvent) => {
    selectedData.fila = e.detail.fila;
    selectedData.numero = e.detail.numero;
    updateSummary();
  }) as EventListener);
  
  window.addEventListener('payment-selected', ((e: CustomEvent) => {
    selectedData.payment = e.detail.method;
    updateSummary();
  }) as EventListener);
  
  // Reservar button
  document.getElementById('btn-reservar')?.addEventListener('click', async () => {
    try {
      await fetchAPI('/reservar', {
        method: 'POST',
        body: JSON.stringify({
          partido: partidoId,
          zona: selectedData.zona,
          fila: selectedData.fila,
          numero: selectedData.numero
        })
      });
      
      alert('¡Reserva realizada! Tienes 15 minutos para completar el pago');
      window.location.href = '/historial';
    } catch (error: any) {
      alert(error.message || 'Error al reservar');
    }
  });
  
  // Comprar button
  document.getElementById('btn-comprar')?.addEventListener('click', async () => {
    try {
      await fetchAPI('/comprar', {
        method: 'POST',
        body: JSON.stringify({
          partido: partidoId,
          zona: selectedData.zona,
          fila: selectedData.fila,
          numero: selectedData.numero,
          metodo_pago: selectedData.payment
        })
      });
      
      alert('¡Compra realizada exitosamente!');
      window.location.href = '/historial';
    } catch (error: any) {
      alert(error.message || 'Error al comprar');
    }
  });
  
  loadPartido();
</script>
