  async function cargarEstadios() {
    try {
      const partidos = await fetchAPI('/partidos');
      const selectHidden = document.getElementById('select-estadio') as HTMLInputElement;
      
      // Buscar el estadio Palogrande entre los partidos existentes
      let idPalogrande = null;
      
      for (const partido of partidos) {
        if (partido.estadio && partido.estadio.nombre === 'Palogrande') {
          idPalogrande = partido.estadio._id;
          break;
        }
      }
      
      // Si no se encuentra, usar el primer estadio disponible como fallback
      if (!idPalogrande && partidos.length > 0 && partidos[0].estadio) {
        idPalogrande = partidos[0].estadio._id;
        console.warn('Estadio Palogrande no encontrado, usando estadio por defecto');
      }
      
      if (selectHidden && idPalogrande) {
        selectHidden.value = idPalogrande;
      }
    } catch (error) {
      console.error('Error cargando estadio:', error);
    }
  }
  
  // Event delegation para botones de ver estadísticas (se crean dinámicamente)
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains('btn-ver-estadisticas') || target.closest('.btn-ver-estadisticas')) {
      const btn = target.classList.contains('btn-ver-estadisticas') ? target : target.closest('.btn-ver-estadisticas');
      const partidoData = btn?.getAttribute('data-partido');
      
      if (partidoData) {
        try {
          const partido = JSON.parse(partidoData);
          mostrarModalEstadisticas(partido);
        } catch (error) {
          console.error('Error parsing partido data:', error);
        }
      }
    }
  });
  
